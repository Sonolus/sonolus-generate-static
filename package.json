{
  "name": "@sonolus/generate-static",
  "version": "5.5.1",
  "description": "CLI tool to generate static Sonolus server from repository and database",
  "author": "NonSpicyBurrito",
  "repository": "github:Sonolus/sonolus-generate-static",
  "license": "MIT",
  "keywords": [
    "Sonolus"
  ],
  "type": "module",
  "bin": {
    "sonolus-generate-static": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check-type": "tsc -p . --noEmit",
    "check-lint": "oxlint",
    "check-format": "oxfmt --check",
    "build": "tsc -p ."
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sonolus/core": "~7.15.4",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typebox": "^1.3.35"
  }
}
